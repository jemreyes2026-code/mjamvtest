rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function boundedString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) || boundedString(data[field], maxLength);
    }

    // Match the payload sent by frontend/src/api/submitLead.js.
    function isValidLead() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'phone', 'service', 'source', 'createdAt'])
        && data.keys().hasOnly([
          'name', 'phone', 'service', 'source', 'createdAt',
          'email', 'date', 'time', 'message'
        ])
        && boundedString(data.name, 200)
        && boundedString(data.phone, 50)
        && (data['service'] in ['Kitchen Exhaust Cleaning', 'Ocular Inspection', 'Minor Repairs'])
        && (data.source in ['contact-form', 'quote-form'])
        && (data.createdAt is timestamp)
        && data.createdAt == request.time
        && optionalString(data, 'email', 254)
        && optionalString(data, 'date', 10)
        && optionalString(data, 'time', 8)
        && optionalString(data, 'message', 10000);
    }

    // Visitors can submit leads without signing in, but cannot retrieve
    // customer details or change existing submissions. Manage leads in
    // Firebase Console using your project's authorized Google account.
    match /leads/{leadId} {
      allow create: if isValidLead();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
